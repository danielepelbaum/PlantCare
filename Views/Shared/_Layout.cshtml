<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlantCare</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlantCare.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="plantcare-layout">
    @{ 
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var navItems = new[]
        {
            new { Action = "Index2", Text = "Inicio" },
            new { Action = "Explorar", Text = "Explorar" },
            new { Action = "MisPlantas", Text = "Mis plantas" },
            new { Action = "Guias", Text = "Guías" },
            new { Action = "Comunidad", Text = "Comunidad" },
            new { Action = "Nosotros", Text = "Sobre nosotros" }
        };
    }

    
<header class="plantcare-header">

    <a class="plantcare-logo" href="@Url.Action("Index2", "Home")">
    <img src="~/logo.png" alt="Logo PlantCare" width="34" height="34">
    <span>PlantCare</span>
    </a>

    <nav class="plantcare-nav">
        @foreach (var item in navItems)
        {
            var isActive = string.Equals(item.Action, currentAction, StringComparison.OrdinalIgnoreCase);

            <a class="@(isActive ? "activo" : "")"
               href="@Url.Action(item.Action, "Home")">
                @item.Text
            </a>
        }
    </nav>

    <a class="plantcare-perfil"
       href="@Url.Action("Perfil", "Home")">
        <svg viewBox="0 0 24 24" width="25" height="25"
             fill="none" stroke="currentColor" stroke-width="1.3">
            <circle cx="12" cy="8" r="4" />
            <path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2" />
        </svg>
    </a>

</header>


    <div class="plantcare-page">
        <main role="main" class="plantcare-main">
            @RenderBody()
        </main>
    </div>

<footer class="plantcare-footer">

    <div class="footer-izquierda">

        <img src="~/logo.png" alt="Logo PlantCare" width="32" height="32">

        <p>
            Pequeñas acciones.<br>
            Grandes cambios.
        </p>

    </div>

    <div class="footer-derecha">

        <nav class="footer-links">
            <a href="@Url.Action("Ayuda", "Home")">AYUDA</a>
            <a href="@Url.Action("Contacto", "Home")">CONTACTO</a>
            <a href="@Url.Action("Terminos", "Home")">TÉRMINOS</a>
            <a href="@Url.Action("Privacidad", "Home")">PRIVACIDAD</a>
        </nav>

        <div class="footer-redes">

            <a href="https://www.instagram.com/" aria-label="Instagram">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5"/>
                    <circle cx="12" cy="12" r="4"/>
                    <circle cx="17.5" cy="6.5" r="1" class="punto"/>
                </svg>
            </a>

            <a href="https://www.youtube.com/" aria-label="YouTube">
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="5" width="20" height="14" rx="4"/>
                    <path d="M10 9 L16 12 L10 15 Z" class="relleno"/>
                </svg>
            </a>

            <a href="https://www.tiktok.com/" aria-label="TikTok">
                <svg viewBox="0 0 24 24">
                    <path d="M14 3 V15 A4 4 0 1 1 10 11"/>
                    <path d="M14 3 C15 7 17 8 21 8"/>
                </svg>
            </a>

        </div>

    </div>

</footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
