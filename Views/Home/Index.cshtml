@{
    ViewData["Title"] = "PlantCare";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlantCare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sinsession.css" asp-append-version="true">

    <style>
        :root {
            --green-dark: #315b25;
            --green: #708b4d;
            --green-soft: #c2cba0;
            --green-pale: #e2e8c5;
            --yellow: #e9dca0;
            --orange: #ffbd80;
            --cream: #f7f5ec;
            --text: #171913;
            --muted: #686b5d;
        }

        * { box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            background: #f5f5f3;
            color: var(--text);
            font-family: "DM Sans", Arial, sans-serif;
            font-size: 13px;
        }

        a { color: inherit; text-decoration: none; }

        .page {
            width: min(100%, 1440px);
            min-height: 100vh;
            margin: 0 auto;
            background: #fff;
            display: flex;
            flex-direction: column;
        }
        
        main {
            width: min(100% - 48px, 1050px);
            margin: 0 auto;
            padding: 78px 0 58px;
            flex: 1;
        }

        .hero {
            display: grid;
            grid-template-columns: .82fr 1.18fr;
            align-items: center;
            gap: 42px;
            margin-bottom: 38px;
        }

        .hero-copy { padding-left: 4px; }

        .hero h1 {
            max-width: 420px;
            margin: 0 0 17px;
            color: var(--green-dark);
            font-size: clamp(30px, 3.4vw, 43px);
            line-height: 1.15;
            letter-spacing: -1.2px;
            font-weight: 800;
        }

        .hero p {
            max-width: 335px;
            margin: 0 0 19px;
            color: #5b3928;
            font-family: Georgia, serif;
            font-size: 13px;
            line-height: 1.55;
        }

        .primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: space-between;
            gap: 35px;
            min-width: 238px;
            border-radius: 30px;
            padding: 13px 22px;
            background: var(--green);
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            transition: background .2s ease, transform .2s ease;
        }

        .primary-button:hover { background: var(--green-dark); transform: translateY(-2px); }
        .primary-button span { font-size: 22px; line-height: 12px; font-weight: 400; }

        .hero-image {
            width: 100%;
            height: 235px;
            border-radius: 27px;
            object-fit: cover;
            display: block;
        }

        .values {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            align-items: center;
            padding: 34px 7%;
            margin-bottom: 40px;
            background: var(--green-soft);
            border-radius: 27px;
        }

        .value-item {
            display: flex;
            align-items: center;
            gap: 17px;
            min-width: 0;
        }

        .value-image {
            flex: 0 0 70px;
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
        }

        .value-item h2 {
            margin: 0 0 8px;
            font-size: 13px;
            font-weight: 800;
        }

        .value-item p {
            margin: 0;
            color: #5b5f4e;
            font-size: 10px;
            line-height: 1.5;
        }

        .progress-panel {
            padding: 25px 27px 26px;
            margin-bottom: 34px;
            border-radius: 25px;
            background: var(--yellow);
        }

        .window-dots {
            display: flex;
            gap: 7px;
            margin: 0 0 24px 2px;
        }

        .window-dots span {
            display: block;
            width: 10px;
            height: 10px;
            border: 1px solid rgba(63, 67, 43, .3);
            border-radius: 50%;
        }

        .window-dots span:nth-child(1) { background: #ffb77b; }
        .window-dots span:nth-child(2) { background: #f7f0c8; }
        .window-dots span:nth-child(3) { background: #77904f; }

        .panel-rule { height: 1px; background: rgba(255,255,255,.75); margin-bottom: 26px; }

        .progress-heading { margin: 0 0 7px 4px; font-size: 20px; font-weight: 800; }
        .progress-intro {
            margin: 0 0 23px 4px;
            color: #585b4c;
            font-size: 13px;
            line-height: 1.5;
        }

        .progress-content {
            display: grid;
            grid-template-columns: 1.35fr .85fr;
            gap: 52px;
            align-items: stretch;
        }

        .chart-card, .week-card {
            min-height: 190px;
            background: #fbfaf5;
            border-radius: 15px;
            padding: 22px 25px;
        }

        .chart {
            height: 132px;
            display: flex;
            align-items: flex-end;
            justify-content: space-around;
            gap: 13px;
            padding: 0 4px 0;
            background: repeating-linear-gradient(to top, transparent 0, transparent 31px, #e6e7dd 32px);
            border-bottom: 1px solid #dedfd4;
        }

        .bar-group {
            height: 100%;
            display: flex;
            flex: 1;
            flex-direction: column;
            justify-content: flex-end;
            align-items: center;
            gap: 7px;
        }

        .bar {
            width: min(100%, 31px);
            border-radius: 6px 6px 0 0;
            animation: grow .8s ease both;
            transform-origin: bottom;
        }

        .bar.orange { background: var(--orange); }
        .bar.green { background: var(--green); }
        .bar.blue { background: #0797c4; }
        .bar-1 { height: 28px; } .bar-2 { height: 57px; } .bar-3 { height: 80px; }
        .bar-4 { height: 113px; } .bar-5 { height: 61px; } .bar-6 { height: 43px; } .bar-7 { height: 91px; }

        .bar-label { color: #74776b; font-size: 10px; }

        .week-card h3 { margin: 0 0 22px; font-size: 13px; }
        .task { display: flex; align-items: flex-start; gap: 13px; margin-bottom: 15px; }
        .task-dot { width: 16px; height: 16px; border-radius: 50%; flex: 0 0 16px; margin-top: 1px; }
        .task-dot.green { background: var(--green); }
        .task-dot.orange { background: var(--orange); }
        .task strong { display: block; margin-bottom: 5px; font-size: 11px; }
        .task small { color: #6a6c5f; font-size: 10px; }
        .task-progress { height: 7px; margin: -3px 0 20px; border-radius: 10px; background: #e1e5d5; overflow: hidden; }
        .task-progress span { display: block; width: 72%; height: 100%; border-radius: inherit; background: var(--green); }

        .panel-caption { margin: 20px 4px 0; color: #686b5d; font-size: 10px; }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 48px;
        }

        .feature-card {
            min-height: 190px;
            padding: 25px 27px;
            border-radius: 27px;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .feature-card:hover { transform: translateY(-4px); box-shadow: 0 9px 22px rgba(46, 55, 27, .08); }
        .feature-card.yellow { background: var(--yellow); }
        .feature-card.orange { background: var(--orange); }
        .feature-card.green { background: var(--green-soft); }

        .feature-title { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
        .feature-title .symbol { font-size: 23px; line-height: 1; color: #7c4d25; }
        .feature-title h2 { margin: 0; font-size: 13px; font-weight: 800; }
        .feature-card p { min-height: 54px; margin: 0 0 15px; color: #656752; font-size: 12px; line-height: 1.5; }
        .more-link { font-size: 11px; font-weight: 800; }
        .more-link span { margin-left: 5px; font-size: 16px; }

        footer {
            min-height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            padding: 15px 5.1%;
            background: var(--green-pale);
        }

        .footer-brand { display: flex; align-items: center; gap: 12px; color: var(--green-dark); }
        .footer-brand .brand-mark { font-size: 25px; }
        .footer-brand p { margin: 0; font-size: 10px; line-height: 1.35; }
        .footer-links { display: flex; align-items: center; gap: clamp(15px, 3vw, 35px); }
        .socials { display: flex; gap: 11px; align-items: center; font-weight: 800; font-size: 13px; }

        @@keyframes grow {
            from { transform: scaleY(.15); opacity: .5; }
            to { transform: scaleY(1); opacity: 1; }
        }

        @@media (max-width: 900px) {
            .navbar { padding: 15px 4%; flex-wrap: wrap; }
            .nav-links { order: 3; width: 100%; margin: 5px 0 0; gap: 25px; }
            .login-button { min-width: auto; padding: 11px 18px; }
            main { padding-top: 45px; }
            .hero { gap: 25px; }
            .hero-image { height: 210px; }
            .values { padding: 27px 4%; gap: 17px; }
            .value-item { gap: 10px; }
            .value-image { width: 55px; height: 55px; flex-basis: 55px; }
            .progress-content { gap: 20px; }
            .feature-grid { gap: 20px; }
            .feature-card { padding: 22px 18px; }
        }

        @@media (max-width: 650px) {
            .navbar { gap: 12px; }
            .brand { font-size: 22px; }
            .nav-links { justify-content: space-between; gap: 10px; }
            .nav-links a { font-size: 8px; }
            main { width: min(100% - 30px, 500px); padding: 35px 0; }
            .hero { grid-template-columns: 1fr; gap: 24px; margin-bottom: 25px; }
            .hero-copy { padding: 0 3px; }
            .hero h1 { font-size: 34px; }
            .hero p { max-width: 100%; }
            .hero-image { height: 220px; border-radius: 20px; }
            .values { grid-template-columns: 1fr; gap: 22px; padding: 25px; border-radius: 20px; margin-bottom: 25px; }
            .value-image { width: 62px; height: 62px; flex-basis: 62px; }
            .value-item p { font-size: 11px; }
            .progress-panel { padding: 20px 15px; border-radius: 20px; }
            .progress-heading { font-size: 19px; }
            .progress-intro { font-size: 12px; }
            .progress-content { grid-template-columns: 1fr; gap: 15px; }
            .chart-card, .week-card { padding: 18px; }
            .chart { gap: 8px; }
            .bar { width: min(100%, 25px); }
            .feature-grid { grid-template-columns: 1fr; gap: 15px; }
            .feature-card { min-height: 0; padding: 23px; }
            .feature-card p { min-height: 0; }
            footer { flex-direction: column; align-items: flex-start; padding: 22px 5%; }
            .footer-links { width: 100%; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
        }
    </style>
</head>
<body>

    <div class="page">
            <header class="inicio-header">

            <a class="inicio-logo" href="@Url.Action("Index", "Home")">
                <img src="~/logo.png" alt="Logo PlantCare">
                <span>PlantCare</span>
            </a>

            <nav class="inicio-nav">

                <a href="@Url.Action("Index", "Home")">
                    INICIO
                </a>

                <a href="@Url.Action("Explorar2", "Home")">
                    EXPLORAR
                </a>

                <a href="@Url.Action("Guias2", "Home")">
                    GUÍAS
                </a>

                <a href="@Url.Action("Nosotros", "Home")">
                    SOBRE NOSOTROS
                </a>

            </nav>

            <a class="inicio-login" href="@Url.Action("Login", "Home")">
                INICIAR SESIÓN
            </a>

        </header>

        <main>
            <section class="hero" id="explorar">
                <div class="hero-copy">
                    <h1>Cuidá tus plantas<br />de forma simple</h1>
                    <p>Aprendé qué necesita cada planta, organizá sus cuidados y recibí ayuda para mantenerlas sanas, todo desde un mismo lugar.</p>
                    <a class="primary-button" href="#guias">Empezar ahora <span aria-hidden="true">⟶</span></a>
                </div>

                <img class="hero-image"
                     src="https://images.unsplash.com/photo-1497250681960-ef046c08a56e?auto=format&fit=crop&w=1200&q=85"
                     alt="Distintas plantas de interior en macetas junto a una ventana" />
            </section>

            <section class="values" aria-label="Cómo te ayuda PlantCare">
                <article class="value-item">
                    <img class="value-image" src="https://images.unsplash.com/photo-1485955900006-10f4d324d411?auto=format&fit=crop&w=180&q=80" alt="" />
                    <div>
                        <h2>CUIDÁ</h2>
                        <p>Organizá riegos, luz y tareas para no olvidarte de ningún cuidado.</p>
                    </div>
                </article>
                <article class="value-item">
                    <img class="value-image" src="https://images.unsplash.com/photo-1459156212016-c812468e2115?auto=format&fit=crop&w=180&q=80" alt="" />
                    <div>
                        <h2>APRENDÉ</h2>
                        <p>Compartí experiencias, dudas y consejos con personas que aman las plantas.</p>
                    </div>
                </article>
                <article class="value-item">
                    <img class="value-image" src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=180&q=80" alt="" />
                    <div>
                        <h2>CRECÉ</h2>
                        <p>Registrá tus cambios y acompañá el crecimiento de cada una de tus plantas.</p>
                    </div>
                </article>
            </section>

            <section class="progress-panel" id="guias">
                <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                <div class="panel-rule"></div>
                <h2 class="progress-heading">Tu progreso</h2>
                <p class="progress-intro">Revisá de forma rápida cómo vienen tus cuidados y qué tareas<br class="desktop-break" /> necesitan atención durante la semana.</p>

                <div class="progress-content">
                    <div class="chart-card" aria-label="Gráfico ilustrativo de cuidados por día">
                        <div class="chart">
                            <div class="bar-group"><div class="bar orange bar-1"></div><span class="bar-label">L</span></div>
                            <div class="bar-group"><div class="bar green bar-2"></div><span class="bar-label">M</span></div>
                            <div class="bar-group"><div class="bar blue bar-3"></div><span class="bar-label">M</span></div>
                            <div class="bar-group"><div class="bar green bar-4"></div><span class="bar-label">J</span></div>
                            <div class="bar-group"><div class="bar orange bar-5"></div><span class="bar-label">V</span></div>
                            <div class="bar-group"><div class="bar blue bar-6"></div><span class="bar-label">S</span></div>
                            <div class="bar-group"><div class="bar orange bar-7"></div><span class="bar-label">D</span></div>
                        </div>
                    </div>

                    <aside class="week-card">
                        <h3>Esta semana</h3>
                        <div class="task">
                            <span class="task-dot green"></span>
                            <div><strong>Riegos completados</strong><small>5 de 7 tareas</small></div>
                        </div>
                        <div class="task-progress"><span></span></div>
                        <div class="task">
                            <span class="task-dot orange"></span>
                            <div><strong>Próximo cuidado</strong><small>Fertilización · En 5 días</small></div>
                        </div>
                    </aside>
                </div>
                <p class="panel-caption">Un vistazo a tus rutinas para que cada planta reciba lo que necesita.</p>
            </section>

            <section class="feature-grid" id="sobre-nosotros" aria-label="Herramientas de PlantCare">
                <article class="feature-card yellow">
                    <div class="feature-title">
                        <span class="symbol" aria-hidden="true">▦</span>
                        <h2>Consejos personalizados</h2>
                    </div>
                    <p>Recibí consejos simples y personalizados según las necesidades de tus plantas.</p>
                    <a class="more-link" href="#guias">Ver más <span aria-hidden="true">→</span></a>
                </article>

                <article class="feature-card orange">
                    <div class="feature-title">
                        <span class="symbol" aria-hidden="true">◷</span>
                        <h2>Recordatorios de riego</h2>
                    </div>
                    <p>Organizá los próximos riegos y recibí avisos para cuidar cada planta a tiempo.</p>
                    <a class="more-link" href="#guias">Ver más <span aria-hidden="true">→</span></a>
                </article>

                <article class="feature-card green">
                    <div class="feature-title">
                        <span class="symbol" aria-hidden="true">▤</span>
                        <h2>Comunidad de plantas</h2>
                    </div>
                    <p>Compartí dudas, experiencias y consejos con la comunidad y aprendé junto a otros usuarios.</p>
                    <a class="more-link" href="#sobre-nosotros">Ver más <span aria-hidden="true">→</span></a>
                </article>
            </section>
        </main>

        <footer>
            <div class="footer-brand">
                <span class="brand-mark">🌱</span>
                <p>Pequeñas acciones.<br />Grandes cambios.</p>
            </div>

            <nav class="footer-links" aria-label="Enlaces del pie de página">
                <a href="#guias">Ayuda</a>
                <a href="#sobre-nosotros">Contacto</a>
                <a href="#">Términos</a>
                <a href="#">Privacidad</a>
                <div class="socials" aria-label="Redes sociales"><span>◎</span><span>▣</span><span>♪</span></div>
            </nav>
        </footer>
    </div>
</body>
</html>
