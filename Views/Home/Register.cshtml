@{
    ViewData["Title"] = "Crear cuenta";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlantCare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sinsession.css" asp-append-version="true">

    <style>
        :root{--dark:#2e5721;--green:#718b4f;--pale:#e1e8c2;--brown:#80502d;--blue:#079ac4}
        *{box-sizing:border-box}
        body{margin:0;background:#e9e9e7;color:#171913;font:12px "DM Sans",Arial,sans-serif}
        a{color:inherit;text-decoration:none}
        main{flex:1;display:flex;justify-content:center;align-items:center;padding:21px 15px 25px}
        .register-card{width:min(100%,540px);padding:29px 40px 22px;border-radius:16px;background:var(--pale)}
        .register-brand{display:flex;justify-content:center;align-items:center;gap:9px;margin-bottom:6px;color:var(--dark);font-size:30px;font-weight:800;letter-spacing:-.8px;white-space:nowrap}
        .register-brand .brand-mark{font-size:39px}
        .register-card h1{margin:0;color:var(--brown);text-align:center;font-size:23px;line-height:1.3;font-weight:500}
        .subtitle{margin:2px 0 14px;color:var(--dark);text-align:center;font-size:11px}
        .alerta{margin:0 0 12px;padding:8px 10px;border-radius:6px;background:#f8d7da;color:#842029;border:1px solid #f5c2c7;font-size:10px;font-weight:600;}
        .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px}
        .form-group{margin-bottom:13px}
        .form-group label{display:block;margin-bottom:6px;color:#754c2c;font-size:9px;font-weight:600}
        .form-group input{width:100%;height:36px;padding:0 11px;border:1px solid var(--brown);border-radius:3px;outline:none;background:transparent;color:#36532a;font:11px "DM Sans",Arial,sans-serif}
        .form-group input:focus{border-color:var(--dark);box-shadow:0 0 0 2px #2e57211f}
        .full{grid-column:1 / -1}
        .submit-button{width:100%;min-height:36px;border:0;border-radius:20px;background:var(--dark);color:#fff;font:800 10px "DM Sans",Arial,sans-serif;cursor:pointer;transition:background .2s,transform .2s}
        .submit-button:hover{background:var(--green);transform:translateY(-1px)}
        .signin{margin:14px 0 0;color:var(--dark);text-align:center;font-size:9px}.signin a{margin-left:8px;color:#75401e;font-weight:800}
        footer{min-height:47px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:10px 4.3%;background:var(--pale)}
        .footer-brand{display:flex;align-items:center;gap:10px;color:var(--dark)}.footer-brand .brand-mark{font-size:24px}.footer-brand p{margin:0;font-size:9px;line-height:1.3}
        .footer-links{display:flex;align-items:center;gap:clamp(13px,3vw,30px)}.footer-links a{font-size:8px;font-weight:700;text-transform:uppercase;white-space:nowrap}
        .socials{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:800}
        @@media(max-width:760px){.navbar{flex-wrap:wrap;padding:10px 4%;gap:10px}.brand{font-size:19px}.nav-links{order:3;width:100%;justify-content:space-between;gap:3px}.nav-links a{padding:7px 5px;font-size:7px}.profile-link{margin-left:5px}main{padding:30px 15px}.register-card{padding:28px 30px 23px}.form-grid{grid-template-columns:1fr}footer{flex-wrap:wrap}.footer-links{width:100%;justify-content:space-between;flex-wrap:wrap;gap:12px}}
        @@media(max-width:420px){.page{padding:0 5px}.register-card{padding:25px 20px 22px}.register-brand{font-size:26px}.register-brand .brand-mark{font-size:34px}.footer-links a{font-size:7px}}
    </style>
</head>
<body>
<div class="page">
    <div class="page-title">Crear cuenta</div>
    <header class="inicio-header">

            <a class="inicio-logo" href="@Url.Action("Index", "Home")">
                <img src="~/logo.png" alt="Logo PlantCare">
                <span>PlantCare</span>
            </a>

            <nav class="inicio-nav">

                <a href="@Url.Action("Index", "Home")">
                    INICIO
                </a>

                <a href="@Url.Action("Explorar2", "Home")">
                    EXPLORAR
                </a>

                <a href="@Url.Action("Guias2", "Home")">
                    GUÍAS
                </a>

                <a href="@Url.Action("Nosotros", "Home")">
                    SOBRE NOSOTROS
                </a>

            </nav>

            <a class="inicio-login" href="@Url.Action("Login", "Home")">
                INICIAR SESIÓN
            </a>

        </header>
    <main>
        <section class="register-card" aria-labelledby="register-title">
            <div class="register-brand"><span class="brand-mark">🌱</span><span>PlantCare</span></div>
            <h1 id="register-title">Crear cuenta</h1>
            <p class="subtitle">Completá tus datos para empezar.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alerta">@ViewBag.Error</div>
            }

            <form method="post" asp-action="Register" asp-controller="Home">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="form-group">
                        <label for="Nombre">Nombre</label>
                        <input id="Nombre" name="Nombre" type="text" required>
                    </div>
                    <div class="form-group">
                        <label for="Apellido">Apellido</label>
                        <input id="Apellido" name="Apellido" type="text" required>
                    </div>
                    <div class="form-group full">
                        <label for="Mail">Correo electrónico</label>
                        <input id="Mail" name="Mail" type="email" required>
                    </div>
                    <div class="form-group">
                        <label for="UsuarioNombre">Usuario</label>
                        <input id="UsuarioNombre" name="UsuarioNombre" type="text" required>
                    </div>
                    <div class="form-group">
                        <label for="Teléfono">Teléfono</label>
                        <input id="Teléfono" name="Teléfono" type="text">
                    </div>
                    <div class="form-group">
                        <label for="Edad">Edad</label>
                        <input id="Edad" name="Edad" type="number" min="1" required>
                    </div>
                    <div class="form-group">
                        <label for="Contraseña">Contraseña</label>
                        <input id="Contraseña" name="Contraseña" type="password" required>
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Repetir contraseña</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" required>
                    </div>
                </div>
                <button class="submit-button" type="submit">CREAR CUENTA</button>
            </form>

            <p class="signin">¿Ya tenés cuenta? <a asp-controller="Home" asp-action="Login">Iniciar sesión</a></p>
        </section>
    </main>
    <footer>
        <div class="footer-brand"><span class="brand-mark">🌱</span><p>Pequeñas acciones.<br>Grandes cambios.</p></div>
        <nav class="footer-links" aria-label="Enlaces del pie de página">
            <a href="#">Ayuda</a><a href="#">Contacto</a><a href="#">Términos</a><a href="#">Privacidad</a>
            <div class="socials" aria-label="Redes sociales"><span>◎</span><span>▣</span><span>♪</span></div>
        </nav>
    </footer>
</div>
</body>
</html>
