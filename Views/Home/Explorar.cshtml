@{
    ViewData["Title"] = "Explorar";
}

<style>
    .explorar {
        --verde-oscuro: #2f5a1e;
        --verde-medio: #6d8b4e;
        --marron: #6b3f1d;
        --card-bg: #bfc99b;
        --chip-bg: #e8d9a0;
        --banner-bg: #f3f5e4;
        --buscador-bg: #fff1e3;
        --link: #0c8ec7;

        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px 60px;
        font-family: 'Inter', 'Segoe UI', sans-serif;
        color: var(--marron);
    }

    .explorar h1 {
        font-size: 2.4rem;
        font-weight: 700;
        color: var(--verde-oscuro);
        margin: 0;
    }

    .explorar .subtitulo {
        margin: 4px 0 18px;
        max-width: 280px;
        font-size: 0.85rem;
        line-height: 1.3;
    }

    /* Buscador */
    .buscador {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--buscador-bg);
        border: 1px solid #b5651d;
        border-radius: 6px;
        padding: 8px 14px;
    }

    .buscador input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.85rem;
        color: var(--marron);
    }

    .buscador input::placeholder {
        color: var(--marron);
        opacity: 0.8;
    }

    /* Banner recomendaciones */
    .banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--banner-bg);
        border-radius: 12px;
        margin-top: 24px;
        overflow: hidden;
        min-height: 66px;
    }

    .banner-texto {
        padding: 12px 20px;
    }

    .banner-texto h3 {
        margin: 0;
        font-size: 1.1rem;
        color: var(--verde-medio);
    }

    .banner-texto p {
        margin: 2px 0 0;
        font-size: 0.78rem;
    }

    .banner-imagen {
        flex: 0 0 335px;
        align-self: stretch;
        display: flex;
        align-items: center;
        justify-content: center;
        background: url('/img/hojas.jpg') center / cover no-repeat, #3f6b2a;
    }

    .btn-recomendaciones {
        background: var(--banner-bg);
        color: var(--marron);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-decoration: none;
        padding: 10px 28px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .btn-recomendaciones:hover {
        background: #fff;
    }

    /* Secciones */
    .seccion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 26px 0 12px;
    }

    .seccion-header h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .ver-todas {
        font-size: 0.75rem;
        color: var(--link);
        text-decoration: none;
        margin-right: 30px;
    }

    .ver-todas:hover {
        text-decoration: underline;
    }

    /* Plantas destacadas */
    .destacadas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .planta-card {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 10px 10px 14px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .planta-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
    }

    .planta-card img {
        width: 100%;
        height: 95px;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    .planta-info {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding: 10px 6px 0;
    }

    .planta-info strong {
        display: block;
        font-size: 0.8rem;
        color: var(--verde-oscuro);
    }

    .planta-info span {
        font-size: 0.7rem;
        color: #7a7a55;
    }

    .planta-info .flecha {
        color: var(--link);
        font-weight: 700;
    }

    /* Categorías */
    .categorias {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
    }

    .categoria {
        background: var(--chip-bg);
        border-radius: 10px;
        padding: 14px 6px;
        text-align: center;
        text-decoration: none;
        color: var(--marron);
        font-size: 0.68rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 62px;
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .categoria:hover {
        background: #dfcb85;
        transform: translateY(-2px);
    }

    .categoria .icono {
        font-size: 1rem;
    }

    /* Responsive */
    @@media (max-width: 800px) {
        .destacadas {
            grid-template-columns: 1fr;
        }

        .categorias {
            grid-template-columns: repeat(2, 1fr);
        }

        .banner {
            flex-direction: column;
            align-items: stretch;
        }

        .banner-imagen {
            flex-basis: 80px;
        }

        .ver-todas {
            margin-right: 0;
        }
    }
</style>

<section class="explorar">
    <h1>Explorar</h1>
    <p class="subtitulo">Descubrí plantas, consejos y todo lo que necesitás para hacer crecer tu mundo verde.</p>

    <!-- Buscador -->
    <form class="buscador" method="get" asp-controller="Home" asp-action="Explorar">
        <span>🔍</span>
        <input type="text" name="q" placeholder="Buscar plantas, cuidados, o temas..." />
    </form>

    <!-- Banner -->
    <div class="banner">
        <div class="banner-texto">
            <h3>¿No sabés qué planta elegir?</h3>
            <p>Explorá nuestras recomendaciones según tu espacio, luz y estilo de vida.</p>
        </div>
        <div class="banner-imagen">
            <a class="btn-recomendaciones" asp-controller="Home" asp-action="Recomendaciones">VER RECOMENDACIONES →</a>
        </div>
    </div>

    <!-- Plantas destacadas -->
    <div class="seccion-header">
        <h2>Plantas destacadas</h2>
        <a class="ver-todas" asp-controller="Home" asp-action="Plantas">Ver todas →</a>
    </div>

    <div class="destacadas">
        <a class="planta-card" href="#">
            <img src="~/img/monstera.jpg" alt="Monstera" />
            <div class="planta-info">
                <div>
                    <strong>Monstera</strong>
                    <span>Ideal para interiores.</span>
                </div>
                <span class="flecha">→</span>
            </div>
        </a>

        <a class="planta-card" href="#">
            <img src="~/img/sansevieria.jpg" alt="Sansevieria" />
            <div class="planta-info">
                <div>
                    <strong>Sansevieria</strong>
                    <span>Resistente y fácil de cuidar.</span>
                </div>
                <span class="flecha">→</span>
            </div>
        </a>

        <a class="planta-card" href="#">
            <img src="~/img/pothos.jpg" alt="Pothos" />
            <div class="planta-info">
                <div>
                    <strong>Pothos</strong>
                    <span>Perfecta para principiantes.</span>
                </div>
                <span class="flecha">→</span>
            </div>
        </a>
    </div>

    <!-- Categorías -->
    <div class="seccion-header">
        <h2>Categorías</h2>
        <a class="ver-todas" asp-controller="Home" asp-action="Plantas">Ver todas →</a>
    </div>

    <div class="categorias">
        <a class="categoria" href="#"><span class="icono">🪴</span>Plantas de Interior</a>
        <a class="categoria" href="#"><span class="icono">☀️</span>Plantas de Exterior</a>
        <a class="categoria" href="#"><span class="icono">💧</span>Plantas por<br />Nivel de Cuidado</a>
        <a class="categoria" href="#"><span class="icono">🐾</span>Plantas Pet Friendly</a>
        <a class="categoria" href="#"><span class="icono">🏠</span>Plantas para Espacios<br />Pequeños</a>
        <a class="categoria" href="#"><span class="icono">🌿</span>Todas las Plantas</a>
    </div>
</section>
