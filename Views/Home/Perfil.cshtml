@{
    ViewData["Title"] = "Mi Perfil";
}

<style>
    .perfil {
        --verde-oscuro: #2f5a1e;
        --verde-medio: #6d8b4e;
        --verde-claro: #e0e6c3;
        --marron: #6b3f1d;
        --beige: #e8d9a0;
        --rojo: #7a0000;
        --link: #0c8ec7;

        max-width: 800px;
        margin: 0 auto;
        padding: 40px 20px 60px;
        font-family: 'Poppins', 'Inter', 'Segoe UI', sans-serif;
        color: var(--marron);
    }

    .perfil h1 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--verde-oscuro);
        margin: 0;
        line-height: 1.1;
    }

    .perfil .subtitulo {
        margin: 0;
        font-size: 0.85rem;
    }

    /* Cabecera */
    .perfil-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .btn-editar {
        background: var(--beige);
        color: #9a8f58;
        border: none;
        border-radius: 10px;
        padding: 10px 40px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        margin-top: 6px;
    }

    .btn-editar:hover {
        background: #dccb88;
        color: var(--marron);
    }

    /* Datos del usuario */
    .perfil-datos {
        display: flex;
        gap: 28px;
        margin-top: 18px;
        align-items: flex-start;
    }

    .avatar {
        position: relative;
        flex: 0 0 195px;
        width: 195px;
        height: 195px;
    }

    .avatar-circulo {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid var(--marron);
        background: #fff;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-circulo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .avatar-placeholder::before {
        content: "";
        position: absolute;
        top: 28%;
        left: 50%;
        transform: translateX(-50%);
        width: 32%;
        height: 32%;
        background: var(--marron);
        border-radius: 50%;
    }

    .avatar-placeholder::after {
        content: "";
        position: absolute;
        top: 62%;
        left: 50%;
        transform: translateX(-50%);
        width: 58%;
        height: 24%;
        background: var(--marron);
        border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }

    .avatar-editar {
        position: absolute;
        right: 0;
        bottom: 6px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #fff;
        border: 1.5px solid var(--link);
        color: var(--link);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        cursor: pointer;
        text-decoration: none;
    }

    .info {
        flex: 1;
    }

    .info h2 {
        margin: 12px 0 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--verde-oscuro);
    }

    .info .usuario {
        margin: 0;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .info .bio {
        margin: 12px 0 14px;
        font-size: 0.75rem;
        line-height: 1.3;
    }

    .info-fila {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .stats {
        flex: 0 0 283px;
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--marron);
        padding: 10px 14px 0;
    }

    .stat {
        text-align: center;
    }

    .stat strong {
        display: block;
        font-size: 1.15rem;
        color: var(--verde-oscuro);
    }

    .stat span {
        font-size: 0.7rem;
        color: var(--verde-medio);
    }

    .btn-cuenta,
    .btn-cerrar {
        border: none;
        border-radius: 10px;
        padding: 10px 0;
        font-size: 0.75rem;
        font-weight: 600;
        color: #fff;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-cuenta {
        background: var(--verde-medio);
        width: 130px;
    }

    .btn-cuenta:hover {
        background: #5c7a40;
    }

    .btn-cerrar {
        background: var(--rojo);
        width: 152px;
    }

    .btn-cerrar:hover {
        background: #5a0000;
    }

    .divisor {
        border: none;
        border-top: 1px solid var(--verde-medio);
        margin: 22px 0 0;
    }

    /* Secciones */
    .perfil h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--verde-oscuro);
        margin: 22px 0 12px;
    }

    /* Ayuda y soporte */
    .ayuda {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .ayuda-card {
        background: var(--verde-claro);
        border-radius: 12px;
        padding: 16px 14px;
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        text-decoration: none;
        color: inherit;
        min-height: 72px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .ayuda-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.12);
    }

    .ayuda-icono {
        font-size: 1.6rem;
        width: 34px;
        text-align: center;
        flex-shrink: 0;
    }

    .ayuda-card strong {
        display: block;
        font-size: 0.8rem;
        color: var(--verde-oscuro);
    }

    .ayuda-card span.desc {
        display: block;
        font-size: 0.68rem;
        color: var(--verde-medio);
        line-height: 1.3;
        padding-right: 16px;
    }

    .ayuda-card .flecha {
        position: absolute;
        right: 12px;
        bottom: 10px;
        font-size: 0.8rem;
    }

    /* Mis plantas */
    .mis-plantas {
        background: var(--beige);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .mi-planta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        min-width: 170px;
        text-decoration: none;
        color: inherit;
    }

    .mi-planta img {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .mi-planta strong {
        display: block;
        font-size: 0.85rem;
        color: var(--verde-oscuro);
    }

    .mi-planta span {
        display: block;
        font-size: 0.62rem;
        color: var(--verde-medio);
        line-height: 1.3;
    }

    .agregar {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--verde-oscuro);
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .agregar-caja {
        width: 60px;
        height: 60px;
        border: 2px dashed var(--verde-oscuro);
        border-radius: 8px;
        background: var(--verde-claro);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: 300;
    }

    .agregar:hover .agregar-caja {
        background: #d3dcae;
    }

    /* Responsive */
    @@media (max-width: 800px) {
        .perfil-datos {
            flex-direction: column;
            align-items: center;
        }

        .info {
            width: 100%;
        }

        .stats {
            flex-basis: 100%;
        }

        .ayuda {
            grid-template-columns: 1fr;
        }

        .perfil-header {
            flex-direction: column;
            gap: 10px;
        }
    }
</style>

<section class="perfil">
    <div class="perfil-header">
        <div>
            <h1>Mi Perfil</h1>
            <p class="subtitulo">Tu espacio, tus plantas, tu progreso.</p>
        </div>
        <a class="btn-editar" href="#">✎ Editar perfil</a>
    </div>

    <div class="perfil-datos">
        <div class="avatar">
            <div class="avatar-circulo">
                <div class="avatar-placeholder"></div>
                <img src="~/img/ImgPerfil.jng" alt="Foto de perfil" />
            </div>
            <a class="avatar-editar" href="#" title="Cambiar foto">✎</a>
        </div>

        <div class="info">
            <h2>Daniel</h2>
            <p class="usuario">@@danieplants</p>
            <p class="bio">Amante de las plantas y la naturaleza.<br />Siempre aprendiendo 🌱</p>

            <div class="info-fila">
                <div class="stats">
                    <div class="stat"><strong>12</strong><span>Plantas</span></div>
                    <div class="stat"><strong>8</strong><span>Publicaciones</span></div>
                    <div class="stat"><strong>3</strong><span>Seguidores</span></div>
                </div>
                <a class="btn-cuenta" asp-controller="Home" asp-action="Login">Cambiar cuenta</a>
                <a class="btn-cerrar" asp-controller="Home" asp-action="Login">⇥ Cerrar sesión</a>
            </div>
        </div>
    </div>

    <hr class="divisor" />

    <!-- Ayuda y soporte -->
    <h3>Ayuda y soporte</h3>
    <div class="ayuda">
        <a class="ayuda-card" href="#">
            <span class="ayuda-icono">❓</span>
            <div>
                <strong>Centro de ayuda</strong>
                <span class="desc">Encontrá respuestas a las preguntas más comunes.</span>
            </div>
            <span class="flecha">→</span>
        </a>

        <a class="ayuda-card" href="#">
            <span class="ayuda-icono">⚙️</span>
            <div>
                <strong>Configuración</strong>
                <span class="desc">Personalizá tu experiencia en PlantCare.</span>
            </div>
            <span class="flecha">→</span>
        </a>

        <a class="ayuda-card" href="#">
            <span class="ayuda-icono">🍃</span>
            <div>
                <strong>Consejos para vos</strong>
                <span class="desc">Descubrí contenido pensado según tus plantas.</span>
            </div>
            <span class="flecha">→</span>
        </a>
    </div>

    <!-- Mis plantas -->
    <h3>Mis plantas</h3>
    <div class="mis-plantas">
        <a class="mi-planta" href="#">
            <img src="~/img/monstera.jpg" alt="Monstera" />
            <div>
                <strong>Monstera</strong>
                <span>Planta de interior. Grandes hojas agujeros naturales.</span>
            </div>
        </a>

        <a class="mi-planta" href="#">
            <img src="~/img/sansevieria.jpg" alt="Sansevieria" />
            <div>
                <strong>Sansevieria</strong>
                <span>Planta de interior. Grandes hojas agujeros naturales.</span>
            </div>
        </a>

        <a class="mi-planta" href="#">
            <img src="~/img/pothos.jpg" alt="Pothos" />
            <div>
                <strong>Pothos</strong>
                <span>Planta de interior. Grandes hojas agujeros naturales.</span>
            </div>
        </a>

        <a class="agregar" asp-controller="Home" asp-action="MisPlantas">
            <div class="agregar-caja">+</div>
            <span>Agregar<br/>planta</span>
        </a>
    </div>
</section>