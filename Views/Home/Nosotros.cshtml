@{
    ViewData["Title"] = "Sobre nosotros";
}

<div style="max-width: 1000px; margin: 48px auto; padding: 0 24px; font-family: 'Segoe UI', sans-serif; color: #1f2d1b;">
    <h1 style="font-size: 2.3rem; margin-bottom: 16px;">Sobre nosotros</h1>
    <p style="font-size: 1.1rem; line-height: 1.8;">
        PlantCare nace para facilitar la vida de quienes quieren cuidar mejor sus plantas sin perderse en detalles.
        Queremos convertir el cuidado cotidiano en una rutina simple, clara y motivadora.
    </p>

    <div style="margin-top: 28px; background: #f4f9f1; border: 1px solid #dfeee0; border-radius: 18px; padding: 24px;">
        <h3 style="margin-top:0;">Nuestra misión</h3>
        <p style="margin:0; line-height:1.7;">
            Ayudar a cada persona a entender, acompañar y disfrutar el crecimiento de su jardín o su espacio verde.
        </p>
    </div>

    <div style="margin-top: 24px;">
        <a asp-controller="Home" asp-action="Index2" style="display:inline-block; background:#2a7a46; color:white; text-decoration:none; padding:12px 22px; border-radius:999px; font-weight:600;">Volver al inicio</a>
    </div>
</div>
