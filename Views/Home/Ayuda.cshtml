@{
    ViewData["Title"] = "Ayuda";
}

<div style="max-width: 900px; margin: 48px auto; padding: 0 24px; font-family: 'Segoe UI', sans-serif; color: #1f2d1b;">
    <h1 style="font-size: 2.3rem; margin-bottom: 20px;">Centro de ayuda</h1>
    <ul style="font-size: 1.06rem; line-height: 2; padding-left: 20px;">
        <li>¿Cómo registro una planta?</li>
        <li>¿Cómo programo un riego?</li>
        <li>¿Dónde veo mis recordatorios?</li>
        <li>¿Puedo compartir consejos con la comunidad?</li>
    </ul>
    <p style="margin-top: 18px;">Si necesitás asistencia adicional, contactanos desde la sección de contacto.</p>
    <a asp-controller="Home" asp-action="Contacto" style="display:inline-block; margin-top: 16px; background:#2a7a46; color:white; text-decoration:none; padding:12px 20px; border-radius:999px; font-weight:600;">Ir a contacto</a>
</div>
