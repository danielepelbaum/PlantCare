@{
    ViewData["Title"] = "Guías";
}
<link rel="stylesheet" href="~/css/sinsession.css" asp-append-version="true">

<header class="inicio-header">

            <a class="inicio-logo" href="@Url.Action("Index", "Home")">
                <img src="~/logo.png" alt="Logo PlantCare">
                <span>PlantCare</span>
            </a>

            <nav class="inicio-nav">

                <a href="@Url.Action("Index", "Home")">
                    INICIO
                </a>

                <a href="@Url.Action("Explorar2", "Home")">
                    EXPLORAR
                </a>

                <a href="@Url.Action("Guias2", "Home")">
                    GUÍAS
                </a>

                <a href="@Url.Action("Nosotros", "Home")">
                    SOBRE NOSOTROS
                </a>

            </nav>

            <a class="inicio-login" href="@Url.Action("Login", "Home")">
                INICIAR SESIÓN
            </a>

        </header>
<div style="max-width: 1100px; margin: 48px auto; padding: 0 24px; font-family: 'Segoe UI', sans-serif; color: #1f2d1b;">
    <h1 style="font-size: 2.3rem; margin-bottom: 16px;">Guías de cuidado</h1>
    <p style="font-size: 1.1rem; line-height: 1.7; max-width: 800px;">
        Descubrí recomendaciones útiles para cada etapa del cuidado de tus plantas: riego, luz, poda, fertilización y más.
    </p>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 32px;">
        <div style="background:#edf7ee; border:1px solid #d8e9d6; padding:20px; border-radius:18px;">
            <h3>🌞 Luz</h3>
            <p>Conocé cuánto sol necesita cada especie y evitá quemaduras o crecimiento débil.</p>
        </div>
        <div style="background:#edf7ee; border:1px solid #d8e9d6; padding:20px; border-radius:18px;">
            <h3>💧 Riego</h3>
            <p>Aprendé a calcular la frecuencia y la cantidad ideal según la temporada y el tipo de maceta.</p>
        </div>
        <div style="background:#edf7ee; border:1px solid #d8e9d6; padding:20px; border-radius:18px;">
            <h3>🌿 Fertilización</h3>
            <p>Usá nutrientes según el estado de la planta para mantenerla sana y vigorosa.</p>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <a asp-controller="Home" asp-action="Index2" style="display:inline-block; background:#2a7a46; color:white; text-decoration:none; padding:12px 22px; border-radius:999px; font-weight:600;">Volver al inicio</a>
    </div>
</div>
